# CLI > 环境变量 > 默认值。普通 .env 不自动加载；可显式设置 ADM_DOTENV。
# 图书馆是主入口；知网、国泰安为显式选择的补充直连。
# ADM_PROVIDERS=whu,cnki,csmar
# ADM_TRANSPORT=stdio
# ADM_HOST=127.0.0.1
# ADM_PORT=7791
# ADM_DATA_DIR=
# ADM_DOWNLOADS_DIR=
# ADM_BROWSER_CHANNEL=auto
# ADM_SHOW_BROWSER=0

# 武大图书馆主入口
# ADM_WHU_LIBRARY_URL=https://www.lib.whu.edu.cn/
# ADM_WHU_BASE_URL=https://whu-primo.hosted.exlibrisgroup.com.cn
# ADM_WHU_VIEW_ID=86WHU
# ADM_WHU_SHOW_BROWSER=1
# ADM_WHU_BROWSER_CHANNEL=chrome
# ADM_WHU_TIMEOUT=30
# ADM_WHU_DOWNLOAD_TIMEOUT=60
# ADM_WHU_MAX_DOWNLOAD_BYTES=104857600
# ADM_WHU_PROXY=http://127.0.0.1:7890

# 知网补充入口（独立登录态）
# ADM_CNKI_BROWSER_CHANNEL=chrome
# ADM_CNKI_SHOW_BROWSER=0

# 国泰安补充入口（完整导出消耗机构配额）
# ADM_CSMAR_BROWSER_CHANNEL=chrome
# ADM_CSMAR_BASE_URL=https://data.csmar.com
# ADM_CSMAR_FILE_BASE=https://file.csmar.com
# ADM_CSMAR_CAPTURE_HEADLESS=1

# 兼容 0.2：ADM_LUOJIA_* 仍被 WHU 读取；ADM_WHU_* 优先。
# ADM_DOTENV=/absolute/path/to/legacy.env
